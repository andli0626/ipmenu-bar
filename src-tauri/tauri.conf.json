{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ip地址",
  "version": "1.2.4",
  "identifier": "com.ipmenubar.tauri",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ip地址",
        "width": 360,
        "height": 430,
        "resizable": false,
        "decorations": true,
        "center": true,
        "visible": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Utility",
    "shortDescription": "IP address display utility",
    "longDescription": "IPMenuBar is a cross-platform menu bar utility that displays your IP address. It supports Public IP (via ipify API) and Local IP (scanning network interfaces).",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
